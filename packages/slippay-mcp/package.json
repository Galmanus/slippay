    "directory": "packages/slippay-mcp"
  },
  "bugs": {
    "url": "https://github.com/Galmanus/slippay/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stellar",
    "soroban",
    "agent-payments",
    "agentic-commerce",
