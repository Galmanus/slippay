{
  "name": "@slippay/arc-agent",
  "version": "0.1.0",
  "description": "Agent-side SDK for Slippay AgentVault on Arc: EIP-712 spend intents, hybrid ECDSA + SLH-DSA-SHA2-128s signing, calldata.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "metrics": "node scripts/arc-metrics.mjs"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1",
    "viem": "2.55.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
